{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir": ".",
    "outDir": "build/tools",
    "sourceMap": true,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "tests/**/*.mts",
    "scripts/**/*.mts",
    "vite.config.mts",
    "src/server/ws-runtime.d.ts"
  ],
  "exclude": []
}
